{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ghanapathfinder.com"
        }
      ],
      "destination": "https://ghanapathfinder.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/news-refresh",
      "schedule": "0 * * * *"
    }
  ]
}